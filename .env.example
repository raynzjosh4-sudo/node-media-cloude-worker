APP_ENV=development
PORT=8000

# Database (defaults to SQLite if empty)
# For Postgres: postgresql://postgres:password@localhost:5432/node_db
DATABASE_URL=sqlite:///./node_api.db

# JWT Configuration
JWT_SECRET_KEY=insecure-dev-secret-key-change-in-production-node-api-backend-32-chars
JWT_EXPIRATION_MINUTES=1440

# Network & Security
CORS_ALLOWED_ORIGINS=*
ALLOWED_HOSTS=*

# Resend Email Configuration
# 1. Get your API key from https://resend.com/api-keys
# 2. Paste your 're_...' key below:
RESEND_API_KEY=re_your_api_key_here

# Verified domain sender (e.g. no-reply@mail.crimchart.com)
RESEND_FROM_EMAIL=no-reply@mail.crimchart.com

# Supabase REST Configuration
SUPABASE_URL=https://lihoygvdnnfqodjjxqnz.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xknRF_gqAzQqznqNvSONRg_j6GkQdrS

# Cloudflare R2 Media & CDN Configuration (from Dart project)
R2_PUBLIC_URL=https://nodemediafiles.crimchart.com
CLOUDFLARE_MEDIA_ENDPOINT=https://nodemediafiles.crimchart.com/_node/media

